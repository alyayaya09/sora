# SORA Arts & Culture - Environment Variables Example
# Salin file ini ke .env.local dan isi nilainya

# ─── Gemini API ─────────────────────────────────────────────────────────────
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Better Auth ────────────────────────────────────────────────────────────
# Minimal 32 karakter. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_at_least_32_chars_here

# URL aplikasi untuk Better Auth callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase Postgres ──────────────────────────────────────────────────────
# Transaction mode (port 6543) — gunakan ini untuk Drizzle + edge
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_database_url_here
